# ============================================================================
# REQUIRED SECURITY VARIABLES
# ============================================================================

# Secret key for Flask sessions (REQUIRED)
# Generate a strong random value with:
#   On Linux/Mac: python3 -c "import secrets; print(secrets.token_hex(32))"
#   On Windows:   python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Use different values for development and production
SECRET_KEY=your_random_secret_key_here_min_32_chars

# Admin Dashboard Password (REQUIRED)
# Generate a strong password with:
#   On Linux/Mac: openssl rand -base64 32
#   On Windows:   python -c "import secrets; print(secrets.token_base64(32))"
# IMPORTANT: Change this before deploying to production
ADMIN_PASSWORD=your_strong_admin_password_here

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Gemini API Configuration (optional but recommended)
# Get your API key from: https://ai.google.dev/
# Leave blank to use local knowledge base only
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins (comma-separated, default: localhost)
# Example: http://localhost,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Database path (default: /data/db.sqlite for Docker)
DATABASE_PATH=/data/db.sqlite

# Flask environment (development or production)
FLASK_ENV=production
